# Disable Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Block Sensitive Files from Direct Web Access
<FilesMatch "(^\..*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.(env|sql|sqlite|log|md|sh|bak))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Route Requests & Block Direct Access to Framework Folders
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive core directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|\.git) - [F,L,NC]

    # Forward all valid traffic to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
